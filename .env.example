# RESUMIND AI — Environment Configuration Example

# Security & Tokens
SECRET_KEY=replace_with_a_secure_random_256_bit_secret_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default, seamlessly switch to PostgreSQL in production)
# SQLite:
DATABASE_URL=sqlite:///./resumind.db
# PostgreSQL (Production on Render/Neon/Supabase/Railway):
# DATABASE_URL=postgresql://user:password@hostname:5432/resumind_production

# Upload Storage Limit (MB)
MAX_FILE_SIZE_MB=15

# Optional AI LLM Integrations (Autonomous heuristic NLP engine active by default without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Real SMTP Email Delivery (Required for OTP email dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=RESUMIND AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
